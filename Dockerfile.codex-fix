FROM weishaw/claude-relay-service:1.1.315 AS frontend
WORKDIR /build
COPY web/admin-spa/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/admin-spa/ ./
RUN npm run build

FROM weishaw/claude-relay-service:1.1.315
COPY src/routes/openaiRoutes.js /app/src/routes/openaiRoutes.js
COPY src/routes/admin/openaiAccounts.js /app/src/routes/admin/openaiAccounts.js
COPY src/services/account/openaiAccountService.js /app/src/services/account/openaiAccountService.js
COPY --from=frontend /build/dist /app/web/admin-spa/dist
